
# 虚拟环境
.venv/
# 本地开发用环境（沙箱内 .venv 不可写时的替代）
.venv-dev/

# Python 缓存
__pycache__/
*.py[cod]

# 工具缓存
.pytest_cache/
.ruff_cache/
.ruff-cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# 打包产物
dist/
build/
*.egg-info/

# 编辑器/系统
.DS_Store
.idea/
.vscode/

# uv / pip 本地缓存
.uv-cache/
.cache/

# 示例构建产物（跑示例就会重新生成）
examples/*/output.html
examples/*/output.docx

# 测试与手工探针的临时目录
.tmp/
.tmp-pytest/
.pytest-tmp/
pytest-tmp/
