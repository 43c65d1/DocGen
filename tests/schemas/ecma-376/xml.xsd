<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal W3C XML namespace schema (http://www.w3.org/XML/1998/namespace).

  ECMA-376 / ISO-IEC 29500 的 WML schema 会 `xs:import` 本命名空间（例如 `xml:space`），
  官方完整版本见 https://www.w3.org/2001/xml.xsd。这里只保留 OOXML 需要的最小声明，
  以便离线用 lxml 做 schema 校验。
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/XML/1998/namespace"
           xmlns:xml="http://www.w3.org/XML/1998/namespace">

  <xs:attribute name="lang" type="xs:language"/>
  <xs:attribute name="space" default="preserve">
    <xs:simpleType>
      <xs:restriction base="xs:NCName">
        <xs:enumeration value="default"/>
        <xs:enumeration value="preserve"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <xs:attribute name="base" type="xs:anyURI"/>
  <xs:attribute name="id" type="xs:ID"/>

  <xs:attributeGroup name="specialAttrs">
    <xs:attribute ref="xml:base"/>
    <xs:attribute ref="xml:lang"/>
    <xs:attribute ref="xml:space"/>
    <xs:attribute ref="xml:id"/>
  </xs:attributeGroup>
</xs:schema>
